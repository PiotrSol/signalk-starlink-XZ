{
  "name": "signalk-starlink-xz",
  "version": "1.3.1",
  "description": "Signal K plugin that reminds you to switch Starlink Ocean Mode off when back in territorial waters (country code leaves XZ) and on beyond 12 nm, and reports the link as METERED in international waters (network.internet.state = metered), so other plugins hold back heavy downloads while data is paid by the gigabyte; also publishes the Starlink link state, throughput and latency and notifies when Starlink goes offline",
  "main": "index.js",
  "signalk-plugin-enabled-by-default": true,
  "scripts": {
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PiotrSol/signalk-starlink-XZ.git"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-hardware",
    "starlink",
    "ocean-mode",
    "priority",
    "xz",
    "territorial-waters",
    "metered",
    "internet",
    "network"
  ],
  "author": "Piotr <piotr.pingo@gmail.com>",
  "contributors": [
    "Ilker Temir <ilker@ilkertemir.com> (original signalk-starlink)",
    "Scott Bender (offline notification)"
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/PiotrSol/signalk-starlink-XZ/issues"
  },
  "homepage": "https://github.com/PiotrSol/signalk-starlink-XZ#readme",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.js",
    "protos/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "icon.svg"
  ],
  "dependencies": {
    "@grpc/grpc-js": "1.14.6",
    "@grpc/proto-loader": "0.8.1"
  },
  "signalk": {
    "displayName": "Starlink XZ: Ocean Mode reminder",
    "appIcon": "./icon.svg"
  }
}
